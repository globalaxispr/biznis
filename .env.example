# BizHaiti ERP - Variáveis de Ambiente Necessárias
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase.

# 1. URL do projeto Supabase (Configurações > API > Project URL)
VITE_SUPABASE_URL=

# 2. Chave Anônima do projeto Supabase (Configurações > API > Project API Keys > anon public)
VITE_SUPABASE_ANON_KEY=
